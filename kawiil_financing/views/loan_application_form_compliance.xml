<odoo>
    <record id="view_loan_application_form_compliance" model="ir.ui.view">
    <field name="name">loan.application.form.compliance</field>
    <field name="model">loan.application</field>
    <field name="inherit_id" ref="view_loan_application_form"/>
    <field name="arch" type="xml">

        <!-- Application Tags -->
        <xpath expr="//field[@name='partner_id']" position="after">
            <field name="tag_ids"
                   widget="many2many_tags"
                   options="{'color_field': 'color'}"/>
        </xpath>

        <!-- Compliance Checklist -->
        <xpath expr="//notebook" position="inside">
            <page string="Compliance Checklist" name="compliance_checklist">

                <field name="document_ids" nolabel="1">
                    <list editable="bottom"
                          decoration-success="state == 'approved'"
                          decoration-danger="state == 'rejected'">

                        <field name="name"/>
                        <field name="type_id"/>
                        <field name="state" widget="badge"/>
                        <field name="attachment_id"/>

                    </list>
                </field>

            </page>
        </xpath>

    </field>
</record>
</odoo>