<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Loan Application Tags -->

        <record id="tag_vip" model="loan.application.tag">
            <field name="name">VIP</field>
            <field name="color">4</field>
        </record>

        <record id="tag_first_time_buyer" model="loan.application.tag">
            <field name="name">First-Time Buyer</field>
            <field name="color">10</field>
        </record>

        <!-- Document Types -->

        <record id="document_type_identity" model="loan.application.document.type">
            <field name="name">Proof of Identity</field>
            <field name="is_required" eval="True"/>
        </record>

        <record id="document_type_income" model="loan.application.document.type">
            <field name="name">Proof of Income</field>
            <field name="is_required" eval="True"/>
        </record>

    </data>
</odoo>